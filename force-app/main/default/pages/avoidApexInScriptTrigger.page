<apex:page controller="avoidApexInScriptTriggerController">
    <apex:form>
        <h1>VF Rule Trigger: vf:AvoidApexInScript</h1>
        <p>This page is designed to trigger the rule: Avoid Apex Tags Within Script</p>
        <p>Rule Description: vf:AvoidApexInScript</p>
        
        <apex:pageBlock title="Test Block">
            <apex:inputText value="{!testValue}" label="Test Input"/>
            <apex:commandButton value="Test Action" action="{!testAction}"/>
        </apex:pageBlock>
    </apex:form>
    <script>
        <apex:repeat value="{! apexArray }" var="entry">      //Bad: Apex tag is used within Script to iterate through array.
          document.write('{! JSENCODE(entry) }');
        </apex:repeat>
      </script>
</apex:page>